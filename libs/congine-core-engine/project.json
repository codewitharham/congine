{
  "name": "congine-core-engine",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/congine-core-engine/src",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "uv run ruff format --check libs/congine-core-engine",
          "uv run ruff check libs/congine-core-engine"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run pytest libs/congine-core-engine/tests"
      }
    }
  }
}